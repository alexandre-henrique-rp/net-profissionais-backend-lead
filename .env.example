# =============================================================================
# Conexões do servidor web (PostgreSQL e Redis compartilhados).
# Substitua os placeholders SEU_* / SUA_* pelos dados reais do servidor.
# =============================================================================
DATABASE_URL="postgresql://SEU_USUARIO:SUA_SENHA@SERVIDOR_WEB:5432/netprofissionais_mvp?schema=public"
REDIS_URL="redis://:SUA_SENHA@SERVIDOR_WEB:6379"

# =============================================================================
# Segredos do seed (doc/mvp/specs/task-s01-06.md).
# O seed falha de propósito se qualquer um dos dois não estiver definido —
# nenhuma senha fica hard-coded no código.
# =============================================================================
SEED_ADMIN_PASSWORD="SUA_SENHA_FORTE_DO_ADMIN"
SEED_TENANT_WEBHOOK_TOKEN="SEU_TOKEN_DE_WEBHOOK"

# =============================================================================
# Seed de homologação E2E (`yarn prisma:seed:e2e`, TASK-S06-06).
# Recria um tenant isolado (e2e.netprofissional.test) com o cenário do
# Playwright. Exige os três valores abaixo — nenhum segredo fica no código.
# Em produção a seed só roda com SEED_E2E_ALLOW_PROD=1.
# =============================================================================
SEED_E2E_PASSWORD="SENHA_DAS_CONTAS_DE_TESTE"
SEED_E2E_WEBHOOK_TOKEN="TOKEN_HMAC_DO_WEBHOOK_DE_TESTE"
SEED_E2E_INVITE_TOKEN="TOKEN_DO_CONVITE_PENDENTE"

# =============================================================================
# Segredo de assinatura do JWT.
# Em desenvolvimento/teste é opcional: sem ele o processo gera um segredo
# efêmero e os tokens deixam de valer a cada restart. Em produção
# (NODE_ENV=production) é OBRIGATÓRIO — a API não sobe sem ele.
# Gere um valor com: openssl rand -hex 32
# =============================================================================
# NODE_ENV=development
# JWT_SECRET=troque-por-um-segredo-aleatorio-de-64-caracteres
# JWT_EXPIRES_IN=8h

# =============================================================================
# CORS — origens liberadas, separadas por vírgula. O padrão é o frontend
# de desenvolvimento (doc/mvp/specs/task-s01-01.md).
# =============================================================================
# CORS_ORIGIN=http://localhost:5173

# =============================================================================
# Observabilidade e porta (opcional).
# =============================================================================
# PORT=3000
# OBSERVE_APP_KEY=
# OBSERVE_APP_SECRET=

# =============================================================================
# Captura da landing page (relé para o webhook de leads).
# O token aqui é o MESMO valor gravado em `Tenant.webhookToken` no Postgres —
# é ele que assina o corpo bruto da entrega. É segredo: nunca vai para o
# navegador e nunca é hard-coded. Gere com: openssl rand -hex 32
# Sem `WEBHOOK_TOKEN` a API sobe normal; só a rota de captura recusa.
# =============================================================================
# WEBHOOK_TOKEN=troque-por-um-token-de-webhook-gerado-com-openssl-rand-hex-32
# WEBHOOK_TENANT_ID=uuid-da-corporacao-que-recebe-os-leads
# WEBHOOK_API_BASE=https://teste-api.kingdevtec.com/api/v1

# =============================================================================
# E-mail transacional (convite e recuperação de senha).
# Sem SMTP_HOST o envio fica em modo no-op — os fluxos funcionam, só não sai
# e-mail. Em produção, preencha tudo.
# =============================================================================
# SMTP_HOST=smtp.seudominio.com.br
# SMTP_PORT=587
# SMTP_USER=usuario@smtp
# SMTP_PASS=senha-do-smtp
# MAIL_FROM="NetProfissionais <nao-responda@seudominio.com.br>"

# =============================================================================
# URL pública do frontend — base dos links enviados por e-mail
# (ativar conta, recuperar senha). Ex.: https://app.seudominio.com.br
# =============================================================================
# FRONTEND_URL=http://localhost:5173
